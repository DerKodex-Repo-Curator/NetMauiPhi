<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NetMauiPhi.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NetMauiPhi"
    xmlns:views="clr-namespace:NetMauiPhi.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="NetMaui Phi Samples">

    <ShellContent
        Title="Phi-4"
        ContentTemplate="{DataTemplate views:Phi4View}"
        Route="Phi4Page" />

    <ShellContent
        Title="Phi-4 Multimodal"
        ContentTemplate="{DataTemplate views:Phi4MultimodalView}"
        Route="Phi4MultimodalPage" />

    <ShellContent
        Title="Phi Rag"
        ContentTemplate="{DataTemplate views:PhiRagView}"
        Route="PhiRagPage" />
</Shell>
